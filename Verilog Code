module magnitude_comparator (
    input  wire [3:0] A,
    input  wire [3:0] B,
    output reg A_greater,
    output reg A_less,
    output reg A_equal
);

always @(*) begin

    if (A > B) begin
        A_greater = 1'b1;
        A_less    = 1'b0;
        A_equal   = 1'b0;
    end

    else if (A < B) begin
        A_greater = 1'b0;
        A_less    = 1'b1;
        A_equal   = 1'b0;
    end

    else begin
        A_greater = 1'b0;
        A_less    = 1'b0;
        A_equal   = 1'b1;
    end

end

endmodule